# Local development defaults.
# For production credentials, copy frontend/.env.production.example to .env.local
# or set the same variables in your hosting dashboard.

VITE_BACKEND_MODE=demo
VITE_ENABLE_DEMO_WALLET=true
VITE_PAYMENT_PROVIDER=mock
VITE_ALLOW_CLIENT_ROLE_SEEDING=false

# Production-only browser-safe values. Leave blank in demo mode.
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-public-anon-key
# VITE_SUPABASE_FUNCTIONS_URL=https://your-project-ref.supabase.co/functions/v1

# Backend/server secrets are not VITE variables.
# Set Supabase Edge Function secrets from frontend/backend/.env.supabase.example.