# Frontend production environment.
# Copy these keys into .env.local for local production testing, or into Vercel/hosting env vars.
# Do not commit real values.

VITE_BACKEND_MODE=production
VITE_ENABLE_DEMO_WALLET=false
VITE_ALLOW_CLIENT_ROLE_SEEDING=false

# Supabase browser-safe credentials.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional. If omitted, the app uses:
# ${VITE_SUPABASE_URL}/functions/v1
# VITE_SUPABASE_FUNCTIONS_URL=https://your-project-ref.supabase.co/functions/v1

# Public provider selector only. Provider secrets belong in Supabase Edge Function secrets.
VITE_PAYMENT_PROVIDER=razorpay
