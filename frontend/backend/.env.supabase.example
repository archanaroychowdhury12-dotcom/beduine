# Supabase Edge Function secrets.
# Set these with: supabase secrets set KEY=value
# Do not expose these through VITE_* frontend variables.

PAYMENT_PROVIDER=razorpay

# Required by Supabase runtime / service-role function access.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-public-anon-key

# Razorpay webhook verification.
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Comma-separated exact frontend origins accepted by Edge Function CORS.
BEDUINE_ALLOWED_ORIGINS=https://www.beduine.in,https://beduine.in

# Cashfree webhook verification, if PAYMENT_PROVIDER=cashfree.
CASHFREE_WEBHOOK_SECRET=your-cashfree-webhook-secret

# PhonePe webhook verification, if PAYMENT_PROVIDER=phonepe.
PHONEPE_SALT_KEY=your-phonepe-salt-key
PHONEPE_SALT_INDEX=1
PHONEPE_WEBHOOK_PATH=/functions/v1/payment-webhook

# Stripe webhook verification, if PAYMENT_PROVIDER=stripe.
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
