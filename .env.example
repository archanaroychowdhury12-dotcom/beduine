# Demo mode configuration
# Set to 'true' to enable the demo wallet, interactive admin/tester balance popover, and mock backend (offline/localStorage mode).
# Set to 'false' to completely hide all demo wallet options (regular users never see them) and reject demo checkout requests.
VITE_ENABLE_DEMO_WALLET=true

# Real backend configuration (used when VITE_ENABLE_DEMO_WALLET=false)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
